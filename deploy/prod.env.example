# 生产 compose 用的环境变量模板(密钥从你的 Secret 注入,不要明文放仓库)
CHAT_BASE_URL=https://api.siliconflow.cn/v1
CHAT_MODEL=deepseek-ai/DeepSeek-V4-Flash
CHAT_API_KEY=change-me
CHAT_THINKING=disabled
EMBED_API_KEY=change-me
RERANK_API_KEY=change-me
TOKEN_BUDGET=2000

AUTH_ENABLED=true
JWT_SECRET=change-me-64-hex
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-strong

DATABASE_URL=mysql+asyncmy://root:root@mysql:3306/mewhelp
TEST_DATABASE_URL=mysql+asyncmy://root:root@mysql:3306/mewhelp_ch02_test
MILVUS_URI=http://milvus-standalone:19530
CHECKPOINTER_BACKEND=postgres
CHECKPOINTER_POSTGRES_URL=postgresql+psycopg://mewhelp:change-me@postgres:5432/mewhelp

RATE_LIMIT_ENABLED=true
REDIS_URL=redis://redis:6379/0
CIRCUIT_BREAKER_ENABLED=true
SEMANTIC_HISTORY_ENABLED=true
SKILLS_ENABLED=true
PII_MASK_ENABLED=true

RETENTION_DAYS_CONVERSATIONS=90
RETENTION_DAYS_AUDIT=180
RETENTION_DAYS_LOW_CONF=180

MCP_LOGISTICS_URL=http://mcp-logistics:8101/mcp
MCP_AFTERSALES_URL=http://mcp-aftersales:8102/mcp

