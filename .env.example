# ============================================================
# MewHelp 环境配置模板。复制为 .env 并填入真实值:
#   cp .env.example .env
# 三组上游(聊天 / 嵌入 / 重排)各自独立,换其中任一不牵动另外两个。
# ============================================================

# ---- 聊天上游(必填)----
# CHAT_MODEL 必须写上游认的真实模型名,没有别名这一层;写错会在首次调模型时报 Model does not exist。
CHAT_BASE_URL=https://api.siliconflow.cn/v1
CHAT_MODEL=deepseek-ai/DeepSeek-V4-Flash
CHAT_API_KEY=sk-xxx
# 对话历史 token 预算(默认 2000,可调)
TOKEN_BUDGET=2000

# ---- 数据库 ----
DATABASE_URL=mysql+asyncmy://root:root@localhost:3306/mewhelp
TEST_DATABASE_URL=mysql+asyncmy://root:root@localhost:3306/mewhelp_test

# ---- 嵌入 BAAI/bge-m3(必填)----
# EMBED_BASE_URL 有内置默认值(硅基流动),换上游才需要填
EMBED_API_KEY=sk-xxx
# EMBED_BASE_URL=https://api.siliconflow.cn/v1

# ---- 重排 BAAI/bge-reranker-v2-m3(必填)----
# RERANK_BASE_URL 有内置默认值(硅基流动)
RERANK_API_KEY=sk-xxx
# RERANK_BASE_URL=https://api.siliconflow.cn/v1
